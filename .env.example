APP_ENV=dev
APP_NAME=day13-observability-lab
LOG_LEVEL=INFO
LOG_PATH=data/logs.jsonl
AUDIT_LOG_PATH=data/audit.jsonl

# OpenAI is optional; leave the key empty to keep using the mock LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
INPUT_COST_PER_MILLION_USD=3
OUTPUT_COST_PER_MILLION_USD=15

# ── Langfuse Tracing ──────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://jp.cloud.langfuse.com
LANGFUSE_PROJECT_ID=
LANGFUSE_PROMPT_NAME=day13-chat
LANGFUSE_PROMPT_LABEL=production
# Chỉ bật khi cần evidence đồng bộ ngay; production nên để false để tránh tăng latency.
LANGFUSE_FLUSH_EACH_REQUEST=false
